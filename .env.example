# These are examples, not automatically loaded. Set environment variables before starting.
MARKET_MODE=demo
# MARKET_MODE=alpaca
# ALPACA_API_KEY=your_key_here
# ALPACA_SECRET_KEY=your_secret_here
# Keep demo and live practice results in separate databases:
# TRADECRAFT_DB=data/iex-practice.sqlite3

# Hosting: backend variables go in Render, not the frontend.
# PUBLIC_DEPLOYMENT=true
# DATABASE_URL=postgresql://USER:PASSWORD@POOLER:5432/postgres?sslmode=require
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
# Public demo is the default until live display rights have been confirmed.
# PUBLIC_MARKET_DATA_LICENSED=false

# Frontend variables go in Vercel. Vite reads .env.local for local testing.
# VITE_API_BASE_URL=https://YOUR-API.onrender.com
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Never put a secret/service-role key or database password in a VITE_ variable.
